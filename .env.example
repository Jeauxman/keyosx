# Required. KeyOSX stores its catalog in MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=change-me

# Required in production. Use a long, unique password and do not commit your real value.
ADMIN_PASSWORD=change-this-to-a-long-unique-password

# Required in production. Generate a long random value, for example: openssl rand -base64 48
ADMIN_SESSION_SECRET=change-this-to-a-long-random-secret

# Optional. Defaults to 3000.
PORT=3000

# Optional. Jack Rabbit works fully offline by default. Set this only to enhance it with an
# OpenAI-compatible provider for wording — it still answers only from the published catalog.
# ASSISTANT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional. Editorial-agent loop. When a visitor opens a cover with no issue in the current period,
# KeyOSX POSTs a request to ISSUE_GENERATOR_URL (once per publication per period). The agent answers by
# POSTing the finished issue to /api/agent/issues with "Authorization: Bearer <AGENT_API_TOKEN>".
# ISSUE_GENERATOR_URL=
# AGENT_API_TOKEN=
# The shared Almanac service (npm run almanac) answers that webhook. Point ISSUE_GENERATOR_URL at it, e.g. http://localhost:8787
# ALMANAC_PORT=8787
# KEYOSX_ORIGIN=http://localhost:3000        # where the Almanac posts drafts and stores knowledge
# KEYOSX_PUBLIC_ORIGIN=                      # public origin used in cover URLs, if different
# ALMANAC_FEEDS=off                          # "on" reads the live news feeds listed in a brand's profile (free, read-only)
# ALMANAC_WRITER=template                    # "llm" = the capped Claude writer (approved 2026-11-04); needs the next four lines
# ALMANAC_ALLOW_PAID=yes
# ANTHROPIC_API_KEY=                         # set ONLY in the service's own environment, never commit it
# ALMANAC_MODEL=claude-haiku-5-5
# ALMANAC_DAILY_CALLS=40                     # hard caps per UTC day; over the cap it falls back to the free writer
# ALMANAC_DAILY_TOKENS=150000
# ALMANAC_DAILY_CAP_USD=                     # optional; also needs ALMANAC_PRICE_IN_PER_MTOK / ALMANAC_PRICE_OUT_PER_MTOK from your console
# CLOUDINARY_CLOUD_NAME= / CLOUDINARY_API_KEY= / CLOUDINARY_API_SECRET=   # optional: look up covers by verified labels
